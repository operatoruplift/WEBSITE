# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Filecoin receipt-anchor (PR #515) — pick ONE provider:
#   1) Lighthouse (single token, easiest):
#        FILECOIN_PROVIDER=lighthouse
#        LIGHTHOUSE_API_KEY=<token from files.lighthouse.storage>
#   2) Pinata (single JWT):
#        FILECOIN_PROVIDER=pinata
#        PINATA_JWT=<JWT from app.pinata.cloud → API Keys>
# Leave unset to disable; the cron at /api/cron/filecoin-anchor will
# 503 honestly until configured. The /security receipt rows hide the
# "View on Filecoin" link when filecoin_cid is NULL.
FILECOIN_PROVIDER=
LIGHTHOUSE_API_KEY=
PINATA_JWT=

# ElevenLabs TTS (PR #516) — used for the demo voiceover, not a
# runtime user feature. /api/voice/synth returns 503 until set.
# Voice ID defaults to "Rachel" (clear narration); override with
# ELEVENLABS_VOICE_ID if you've cloned a custom voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5

# 0G Storage receipt-anchor (PR #569) — the second public mirror
# for every signed receipt, sister to the Filecoin block above.
# Fund the wallet at https://faucet.0g.ai before the cron at
# /api/cron/og-anchor can do work. Leave unset to disable; the
# 0g: <rootHash> link on /security stays hidden until anchored.
# Optional overrides default to the documented Galileo Testnet
# endpoints.
OG_PRIVATE_KEY=
OG_RPC_URL=
OG_INDEXER_RPC=

# 0G AgenticID (ERC-7857) mint contract (PR #571 + #574). The
# default points at the 0G Foundation reference deployment on
# Galileo Testnet (0x2700F6A3e505402C9daB154C5c6ab9cAEC98EF1F).
# Override only if you deploy your own AgenticID contract.
# Re-uses OG_PRIVATE_KEY above. Run scripts/og-agent-id-mint.mjs
# once the wallet is funded; tokenIds persist to data/og-agent-ids.json
# and surface on /agents/{slug}.json automatically.
OG_AGENT_ID_CONTRACT=
OG_AGENT_ID_CHAIN_EXPLORER=

# Arkiv (ETHLisbon challenge entrant). The Arkiv layer is a third
# public mirror for agent identity cards (sister to /agents/<slug>.json
# served from origin) and the substrate for user-ownable agent memory.
# Fund the wallet at https://braga.hoodi.arkiv.network/faucet/ before
# scripts/arkiv/publish-agents.mjs can do work. The public /api/arkiv/*
# read paths work without any of these env vars set (the page surfaces
# the empty state honestly).
#
# NEXT_PUBLIC_ARKIV_CREATOR_ADDRESS is the wallet address derived from
# ARKIV_PRIVATE_KEY; it's exposed to the client so /api/arkiv/agents
# can filter reads by .createdBy() and reject entities created by
# anyone else under the same PROJECT_ATTRIBUTE.
ARKIV_PRIVATE_KEY=
NEXT_PUBLIC_ARKIV_CREATOR_ADDRESS=
